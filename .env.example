# Telegram Bot API
BOT_TOKEN=1234567890:replace_me

# Telegram MTProto credentials from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=replace_me

# Generate this with: python scripts/generate_telethon_session.py
TELETHON_SESSION_STRING=replace_me

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true

# Safety: destructive bulk moderation is disabled by default.
ENABLE_DESTRUCTIVE_COMMANDS=false
